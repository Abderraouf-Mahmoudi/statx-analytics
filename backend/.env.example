# Release 1 local-first configuration
DATABASE_URL=sqlite:///./statx.db
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATA_ROOT=../data
DEFAULT_LOCALE=fr
SQLITE_BUSY_TIMEOUT_MS=5000

# API-Football — put the real key only in ignored backend/.env
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_CEILING=90
API_FOOTBALL_CACHE_DAYS=7
API_FOOTBALL_FIXTURE_CACHE_MINUTES=30
API_FOOTBALL_FREE_PLAN_FALLBACK_SEASON=2024
API_FOOTBALL_MEDIA_HOSTS=["media.api-sports.io"]

# Player portraits
MAX_PLAYER_PHOTO_BYTES=10485760
MAX_PLAYER_PHOTO_PIXELS=24000000
PLAYER_PHOTO_MODEL=u2net_human_seg
PROVIDER_WORKER_POLL_SECONDS=2

# Experimental modules retained outside the Release 1 critical path
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
MAX_VIDEO_UPLOAD_BYTES=32212254720
VISION_MODEL_PATH=yolov8n.pt
